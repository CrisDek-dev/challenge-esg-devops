# Copie este arquivo para ".env" (nao versionado) e ajuste os valores para rodar localmente:
#   copy .env.example .env      (Prompt de Comando do Windows)
#   cp .env.example .env        (PowerShell, Git Bash, Linux/Mac)
#
# Se for trocar a senha, troque ANTES do primeiro "docker compose up"
# (o banco guarda a senha no volume; depois disso use "docker compose down -v").
#
# SA_PASSWORD: minimo 8 caracteres, com maiuscula, minuscula, numero e simbolo (regra do SQL Server).
SA_PASSWORD=Troque@Senha123
# JWT_SECRET_KEY: minimo 32 caracteres.
JWT_SECRET_KEY=troque-esta-chave-por-uma-aleatoria-com-32-ou-mais-caracteres

# Opcionais para rodar local (se omitidos, o compose usa porta 8080 e ambiente Production)
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
# API_IMAGE=ghcr.io/crisdek-dev/challenge-esg-devops:latest
