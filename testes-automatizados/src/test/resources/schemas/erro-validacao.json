{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Erro de validacao",
  "description": "Contrato do erro 400 de validacao dos dados de entrada (ValidationProblemDetails do ASP.NET Core)",
  "type": "object",
  "required": ["type", "title", "status", "errors"],
  "properties": {
    "type": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "type": "integer", "const": 400 },
    "errors": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string" }
      }
    },
    "traceId": { "type": "string" }
  }
}
