{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Consumo por setor",
  "description": "Contrato da resposta 200 de GET /api/dashboard/consumo-por-setor",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["setorId", "setorNome", "limiteMensalKwh", "consumoTotalKwh", "percentualUtilizado", "quantidadeEquipamentos", "alertasAbertos"],
    "properties": {
      "setorId": { "type": "integer", "minimum": 1 },
      "setorNome": { "type": "string", "minLength": 1 },
      "limiteMensalKwh": { "type": "number", "minimum": 0 },
      "consumoTotalKwh": { "type": "number", "minimum": 0 },
      "percentualUtilizado": { "type": "number", "minimum": 0 },
      "quantidadeEquipamentos": { "type": "integer", "minimum": 0 },
      "alertasAbertos": { "type": "integer", "minimum": 0 }
    },
    "additionalProperties": false
  }
}
